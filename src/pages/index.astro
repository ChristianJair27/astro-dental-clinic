---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Treatments from '../components/Treatments.astro';
import Specialist from '../components/Specialist.astro';
import FirstVisit from '../components/FirstVisit.astro';
import Payments from '../components/Payments.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Location from '../components/Location.astro';
import ContactForm from '../components/ContactForm.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { localBusinessSchema, faqSchema, websiteSchema } from '../lib/schema';
---

<Base schema={[websiteSchema(), localBusinessSchema(), faqSchema()]}>
  <Header />
  <main id="main">
    <Hero />
    <Treatments />
    <Specialist />
    <FirstVisit />
    <Payments />
    <Testimonials />
    <CtaBand />
    <Faq />
    <Location />
    <ContactForm />
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>

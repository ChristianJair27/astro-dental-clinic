---
import { site } from '../config/site';
import Icon from './Icon.astro';

const { firstVisit: fv } = site;
---

<section id="primera-visita" class="py-16 md:py-24" data-section="first-visit">
  <div class="container-page">
    <h2 class="section-title">{fv.heading}</h2>
    <p class="mt-3 max-w-2xl text-muted">{fv.sub}</p>
    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        fv.steps.map((step, i) => (
          <li class="relative rounded-3xl bg-sand-50 p-6 ring-1 ring-sand-100">
            <span class="inline-flex size-10 items-center justify-center rounded-full bg-brand-700 text-lg font-bold text-white" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="mt-4 text-lg font-bold text-brand-900">{step.title}</h3>
            <p class="mt-2 text-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-8 rounded-3xl border border-brand-100 p-6">
      <h3 class="font-bold text-brand-900">Qué traer a tu cita</h3>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
        {fv.bring.map((b) => <li class="flex gap-2 text-muted"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-brand-700" />{b}</li>)}
      </ul>
    </div>
  </div>
</section>

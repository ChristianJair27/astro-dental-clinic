---
import { site } from '../config/site';
import Icon from './Icon.astro';

const { payments: p } = site;
---

<section id="pagos" class="bg-sand-50 py-16 md:py-24" data-section="payments">
  <div class="container-page">
    <h2 class="section-title">{p.heading}</h2>
    <p class="mt-3 max-w-2xl text-muted">{p.sub}</p>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      <div class="rounded-3xl bg-white p-6 ring-1 ring-sand-100">
        <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-700"><Icon name="card" /></span>
        <h3 class="mt-4 text-lg font-bold text-brand-900">Formas de pago</h3>
        <ul class="mt-3 space-y-2 text-muted">
          {p.methods.map((m) => <li class="flex gap-2"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-brand-700" />{m}</li>)}
        </ul>
      </div>
      <div class="rounded-3xl bg-white p-6 ring-1 ring-sand-100">
        <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-700"><Icon name="shield" /></span>
        <h3 class="mt-4 text-lg font-bold text-brand-900">Seguros de gastos médicos</h3>
        <p class="mt-3 text-muted">{p.insurance}</p>
      </div>
      <div class="rounded-3xl bg-white p-6 ring-1 ring-sand-100">
        <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-700"><Icon name="file" /></span>
        <h3 class="mt-4 text-lg font-bold text-brand-900">Factura</h3>
        <p class="mt-3 text-muted">{p.invoice}</p>
      </div>
    </div>
  </div>
</section>
